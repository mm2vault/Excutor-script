-- ═══════════════════════════════════════════════════════════════
-- CHARACTER HELPERS
-- ═══════════════════════════════════════════════════════════════
function getCharacter()
    return LocalPlayer.Character
end

function getHRP()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

function getRole(player)
    if player == LocalPlayer then return "Local" end
    local char = player.Character
    if not char then return "Innocent" end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") then return "Murderer" end
            if n:find("gun") or n:find("revolver") then return "Sheriff" end
        end
    end
    return "Innocent"
end

local function roleColor(r)
    if r == "Murderer" then return Color3.fromRGB(255, 70, 70) end
    if r == "Sheriff"  then return Color3.fromRGB(70, 160, 255) end
    return Color3.fromRGB(70, 230, 120)
end

-- ═══════════════════════════════════════════════════════════════
-- FLY SYSTEM (BodyVelocity + BodyGyro — physics-integrated, not CFrame)
-- ═══════════════════════════════════════════════════════════════
local FlyState = { active = false, bodyVel = nil, bodyGyro = nil, conn = nil }

function startFly()
    local hrp = getHRP()
    if not hrp then return end
    FlyState.active = true

    FlyState.bodyVel = new("BodyVelocity", {
        MaxForce = Vector3.new(1e5, 1e5, 1e5),
        Velocity = Vector3.zero,
        Parent = hrp,
    })
    FlyState.bodyGyro = new("BodyGyro", {
        MaxTorque = Vector3.new(1e5, 1e5, 1e5),
        P = 1500, D = 50,
        CFrame = hrp.CFrame,
        Parent = hrp,
    })

    if FlyState.conn then FlyState.conn:Disconnect() end
    FlyState.conn = RunService.Heartbeat:Connect(function()
        if not State.Fly or not FlyState.active then
            if FlyState.conn then FlyState.conn:Disconnect() end
            stopFly()
            return
        end
        local hrp2 = getHRP()
        if not hrp2 or not FlyState.bodyVel then return end

        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

        if dir.Magnitude > 0 then dir = dir.Unit * State.FlySpeed end
        FlyState.bodyVel.Velocity = dir
        FlyState.bodyGyro.CFrame = Camera.CFrame
    end)
end

function stopFly()
    FlyState.active = false
    if FlyState.bodyVel then FlyState.bodyVel:Destroy() FlyState.bodyVel = nil end
    if FlyState.bodyGyro then FlyState.bodyGyro:Destroy() FlyState.bodyGyro = nil end
    if FlyState.conn then FlyState.conn:Disconnect() FlyState.conn = nil end
end

-- ═══════════════════════════════════════════════════════════════
-- ESP SYSTEM
-- ═══════════════════════════════════════════════════════════════
function createESP(player)
    if player == LocalPlayer or ESPObjects[player] then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local color = roleColor(getRole(player))

    local bb = new("BillboardGui", {
        Name = "MM2_ESP",
        Adornee = head,
        Size = UDim2.new(0, 180, 0, 44),
        StudsOffset = Vector3.new(0, 2.6, 0),
        AlwaysOnTop = true,
        Parent = head,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0.5, 0),
        BackgroundTransparency = 1,
        Text = player.Name,
        TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0,
        Font = Theme.FontBold,
        TextScaled = true,
        Parent = bb,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0.5, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundTransparency = 1,
        Text = getRole(player),
        TextColor3 = color,
        TextStrokeTransparency = 0,
        Font = Theme.FontBold,
        TextScaled = true,
        Parent = bb,
    })

    local hl = new("Highlight", {
        Name = "MM2_ESP_Highlight",
        Adornee = char,
        FillColor = color,
        OutlineColor = Color3.new(1, 1, 1),
        FillTransparency = 0.7,
        OutlineTransparency = 0,
        Parent = char,
    })

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Thickness = 1
    tracer.Color = color
    tracer.Transparency = 0.8

    ESPObjects[player] = { bb = bb, hl = hl, tracer = tracer }
end

function removeESP(player)
    local d = ESPObjects[player]
    if not d then return end
    pcall(function() d.bb:Destroy() end)
    pcall(function() d.hl:Destroy() end)
    pcall(function() d.tracer:Remove() end)
    ESPObjects[player] = nil
end

function refreshAllESP()
    if not State.ESP then
        for p in pairs(ESPObjects) do removeESP(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then createESP(p) end
    end
end

-- ESP render loop (tracers)
Connections.ESPRender = RunService.RenderStepped:Connect(function()
    if not State.ESP then
        for _, d in pairs(ESPObjects) do
            if d.tracer then d.tracer.Visible = false end
        end
        return
    end
    local bottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    for p, d in pairs(ESPObjects) do
        if not p.Parent or not p.Character then removeESP(p) continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not d.tracer then continue end
        if State.ESPTracer then
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            if on then
                d.tracer.From = bottom
                d.tracer.To = Vector2.new(sp.X, sp.Y)
                d.tracer.Color = roleColor(getRole(p))
                d.tracer.Visible = true
            else
                d.tracer.Visible = false
            end
        else
            d.tracer.Visible = false
        end
    end
end)
