-- TAB SYSTEM
-- ═══════════════════════════════════════════════════════════════
local Tabs = {}
local ActiveTab = nil

local function createTab(name)
    local tabBtn = new("TextButton", {
        Size = UDim2.new(1, -8, 0, 32),
        BackgroundColor3 = Theme.SurfaceLight,
        Text = name,
        TextColor3 = Theme.TextDim,
        Font = Theme.FontBold,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = Sidebar,
    })
    corner(tabBtn, 6)

    local tab = { button = tabBtn, name = name, entries = {} }
    Tabs[#Tabs + 1] = tab

    local function setActive()
        ActiveTab = tab
        for _, t in ipairs(Tabs) do
            local on = t == tab
            t.button.TextColor3 = on and Theme.Text or Theme.TextDim
            t.button.BackgroundColor3 = on and Theme.Accent or Theme.SurfaceLight
        end
        ScrollList:ClearAllChildren()
        ListLayout = new("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = ScrollList,
        })
        for _, fn in ipairs(tab.entries) do fn() end
    end

    tab.setActive = setActive

    function tab:Add(fn)
        table.insert(self.entries, fn)
        if ActiveTab == self then fn() end
    end

    tabBtn.MouseButton1Click:Connect(setActive)

    local idx = 0
    for i, t in ipairs(Tabs) do
        if t == tab then idx = i - 1 break end
    end
    tabBtn.Position = UDim2.new(0, 4, 0, 4 + idx * 36)

    return tab
end

