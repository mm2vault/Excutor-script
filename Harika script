-- ═══════════════════════════════════════════════════════════════
-- CHARACTER HELPERS
-- ═══════════════════════════════════════════════════════════════
function getCharacter()
    return LocalPlayer.Character
end

function getHRP()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

function getRole(player)
    if player == LocalPlayer then return "Local" end
    local char = player.Character
    if not char then return "Innocent" end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") then return "Murderer" end
            if n:find("gun") or n:find("revolver") then return "Sheriff" end
        end
    end
    return "Innocent"
end

function roleColor(r)
    if r == "Murderer" then return Color3.fromRGB(255, 70, 70) end
    if r == "Sheriff"  then return Color3.fromRGB(70, 160, 255) end
    return Color3.fromRGB(70, 230, 120)
end

