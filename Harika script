    end
end)

-- Dash (hold LeftShift)
Connections.Dash = RunService.Heartbeat:Connect(function()
    local h = getHumanoid()
    if not h then return end
    if State.Dash and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        h.WalkSpeed = State.DashSpeed
    elseif not State.BunnyHop then
        h.WalkSpeed = State.WalkSpeed
    end
end)

-- Orbit around nearest player
local OrbitAngle = 0
Connections.Orbit = RunService.Heartbeat:Connect(function(dt)
    if not State.Orbit then return end
    local hrp = getHRP()
    if not hrp then return end

    local nearest, ndist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local t = p.Character:FindFirstChild("HumanoidRootPart")
            if t then
                local d = (t.Position - hrp.Position).Magnitude
                if d < ndist then ndist, nearest = d, t end
            end
        end
    end
    if not nearest then return end

    OrbitAngle += dt * State.OrbitSpeed
    local offset = Vector3.new(
        math.cos(OrbitAngle) * State.OrbitRadius,
        3,
        math.sin(OrbitAngle) * State.OrbitRadius
    )
    hrp.CFrame = CFrame.new(nearest.Position + offset)
end)

