local Widgets = {}

function Widgets.Button(parent, text, callback)
    local btn = new("TextButton", {
        Size = UDim2.new(1, -12, 0, 28),
        BackgroundColor3 = Theme.Surface2,
        Text = text, TextColor3 = Theme.Text,
        Font = Theme.FontBold, TextSize = 12,
        AutoButtonColor = false, Parent = parent,
    })
    corner(btn, 5)
    stroke(btn, Theme.Surface2, 1, 0.5)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.Accent }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.Surface2 }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then pcall(callback) end
    end)
    return btn
end

function Widgets.Toggle(parent, text, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -12, 0, 28),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -46, 1, 0), BackgroundTransparency = 1,
        Text = text, TextColor3 = Theme.Text, Font = Theme.Font,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local sw = new("Frame", {
        Size = UDim2.new(0, 34, 0, 18),
        Position = UDim2.new(1, -34, 0.5, -9),
        BackgroundColor3 = default and Theme.Accent or Theme.Surface2,
        Parent = row,
    })
    corner(sw, 9)
    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.new(1, 1, 1), Parent = sw,
    })
    corner(knob, 7)
    local state = default
    local click = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", Parent = row,
    })
    click.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(sw, TweenInfo.new(0.12), {
            BackgroundColor3 = state and Theme.Accent or Theme.Surface2,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.12), {
            Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        }):Play()
        if callback then pcall(callback, state) end
    end)
    return row
end

function Widgets.Slider(parent, text, min, max, default, suffix, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -12, 0, 44),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -50, 0, 16), BackgroundTransparency = 1,
        Text = text, TextColor3 = Theme.Text, Font = Theme.Font,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local valLabel = new("TextLabel", {
        Size = UDim2.new(0, 50, 0, 16),
        Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1,
        Text = tostring(default) .. (suffix or ""), TextColor3 = Theme.Accent,
        Font = Theme.FontBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
    })
    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 0, 26),
        BackgroundColor3 = Theme.Surface2, Parent = row,
    })
    corner(track, 3)
    local fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent, Parent = track,
    })
    corner(fill, 3)
    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valLabel.Text = tostring(v) .. (suffix or "")
        if callback then pcall(callback, v) end
    end
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1, Text = "", Parent = row,
    })
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    return row
end

function Widgets.Section(parent, text)
    local f = new("Frame", {
        Size = UDim2.new(1, -12, 0, 20),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = string.upper(text), TextColor3 = Theme.Accent,
        Font = Theme.FontBold, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    return f
end

function Widgets.Dropdown(parent, text, options, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -12, 0, 28),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1,
        Text = text, TextColor3 = Theme.Text, Font = Theme.Font,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local current = default or options[1]
    local btn = new("TextButton", {
        Size = UDim2.new(0, 70, 1, 0), Position = UDim2.new(1, -70, 0, 0),
        BackgroundColor3 = Theme.Surface2,
        Text = current, TextColor3 = Theme.Accent,
        Font = Theme.FontBold, TextSize = 11,
        AutoButtonColor = false, Parent = row,
    })
    corner(btn, 5)
    local open = false
    local menu
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            menu = new("Frame", {
                Size = UDim2.new(0, 100, 0, #options * 24),
                Position = UDim2.new(1, -100, 1, 4),
                BackgroundColor3 = Theme.Surface2,
                BorderSizePixel = 0,
                ZIndex = 10, Parent = row,
            })
            corner(menu, 5)
            for i, opt in ipairs(options) do
                local o = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, (i - 1) * 24),
                    BackgroundColor3 = Theme.Surface2,
                    Text = opt, TextColor3 = Theme.Text,
                    Font = Theme.Font, TextSize = 11,
                    AutoButtonColor = false, ZIndex = 11, Parent = menu,
                })
                corner(o, 4)
                o.MouseEnter:Connect(function()
                    o.BackgroundColor3 = Theme.Accent
                end)
                o.MouseLeave:Connect(function()
                    o.BackgroundColor3 = Theme.Surface2
                end)
                o.MouseButton1Click:Connect(function()
                    current = opt
                    btn.Text = opt
                    open = false
                    if menu then menu:Destroy() menu = nil end
                    if callback then pcall(callback, opt) end
                end)
            end
        elseif menu then
            menu:Destroy(); menu = nil
        end
    end)
    return row
end

