-- WIDGETS
-- ═══════════════════════════════════════════════════════════════
local Widgets = {}

function Widgets.Button(parent, text, callback)
    local btn = new("TextButton", {
        Size = UDim2.new(1, -16, 0, 32),
        BackgroundColor3 = Theme.SurfaceLight,
        Text = text, TextColor3 = Theme.Text,
        Font = Theme.FontBold, TextSize = 13,
        AutoButtonColor = false, Parent = parent,
    })
    corner(btn, 6)
    stroke(btn, Theme.SurfaceLight, 1, 0.5)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Accent }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.SurfaceLight }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then pcall(callback) end
    end)
    return btn
end

function Widgets.Toggle(parent, text, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -16, 0, 34),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1,
        Text = text, TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local sw = new("Frame", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = default and Theme.Accent or Theme.SurfaceLight,
        Parent = row,
    })
    corner(sw, 10)
    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1), Parent = sw,
    })
    corner(knob, 8)
    local state = default
    local click = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", Parent = row,
    })
    click.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(sw, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Theme.Accent or Theme.SurfaceLight,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        }):Play()
        if callback then pcall(callback, state) end
    end)
    return row
end

function Widgets.Slider(parent, text, min, max, default, suffix, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -16, 0, 52),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -50, 0, 18), BackgroundTransparency = 1,
        Text = text, TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local valLabel = new("TextLabel", {
        Size = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1,
        Text = tostring(default) .. (suffix or ""), TextColor3 = Theme.Accent,
        Font = Theme.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })
    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 32),
        BackgroundColor3 = Theme.SurfaceLight, Parent = row,
    })
    corner(track, 3)
    local fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent, Parent = track,
    })
    corner(fill, 3)
    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valLabel.Text = tostring(value) .. (suffix or "")
        if callback then pcall(callback, value) end
    end
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 27),
        BackgroundTransparency = 1, Text = "", Parent = row,
    })
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return row
end

function Widgets.Section(parent, text)
    local f = new("Frame", {
        Size = UDim2.new(1, -16, 0, 24),
        BackgroundTransparency = 1, Parent = parent,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = string.upper(text), TextColor3 = Theme.Accent,
        Font = Theme.FontBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    return f
end
