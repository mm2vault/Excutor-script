Connections.KillAll = task.spawn(function()
    while task.wait(0.4) do
        if not State.KillAll then continue end
        local char = getCharacter()
        if not char then continue end

        local knife
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("knife") then
                knife = t; break
            end
        end
        if not knife then continue end

        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local c = p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                knife.Parent = char
                task.wait(0.03)
                if knife:FindFirstChild("Handle") then
                    knife.Handle.CFrame = hrp.CFrame
                end
                task.wait(0.03)
            end
        end
    end
end)

