-- ═══════════════════════════════════════════════════════════════
-- FLY (BodyVelocity + BodyGyro — physics-integrated)
-- ═══════════════════════════════════════════════════════════════
local FlyState = { active = false, bodyVel = nil, bodyGyro = nil, conn = nil }

function startFly()
    local hrp = getHRP()
    if not hrp then return end
    FlyState.active = true

    FlyState.bodyVel = new("BodyVelocity", {
        MaxForce = Vector3.new(1e5, 1e5, 1e5),
        Velocity = Vector3.zero,
        Parent = hrp,
    })
    FlyState.bodyGyro = new("BodyGyro", {
        MaxTorque = Vector3.new(1e5, 1e5, 1e5),
        P = 1500, D = 50,
        CFrame = hrp.CFrame,
        Parent = hrp,
    })

    if FlyState.conn then FlyState.conn:Disconnect() end
    FlyState.conn = RunService.Heartbeat:Connect(function()
        if not State.Fly or not FlyState.active then
            if FlyState.conn then FlyState.conn:Disconnect() end
            return
        end
        local h = getHRP()
        if not h or not FlyState.bodyVel then return end

        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

        if dir.Magnitude > 0 then dir = dir.Unit * State.FlySpeed end
        FlyState.bodyVel.Velocity = dir
        FlyState.bodyGyro.CFrame = Camera.CFrame
    end)
end

function stopFly()
    FlyState.active = false
    if FlyState.bodyVel then FlyState.bodyVel:Destroy() FlyState.bodyVel = nil end
    if FlyState.bodyGyro then FlyState.bodyGyro:Destroy() FlyState.bodyGyro = nil end
    if FlyState.conn then FlyState.conn:Disconnect() FlyState.conn = nil end
end

