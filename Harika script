-- SHELL EXPAND — first tab pulls the window open
-- ═══════════════════════════════════════════════════════════════
local ShellExpanded = false
local function expandShell()
    if ShellExpanded then return end
    ShellExpanded = true
    local tween = TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 420, 0, 320),
    })
    tween:Play()
    Body.BackgroundTransparency = 1
    Sidebar.Visible = true
    Content.Visible = true
end

-- collapse back to compact — used by minimize hotkey
local function collapseShell()
    if not ShellExpanded then return end
    ShellExpanded = false
    TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
        Size = UDim2.new(0, 260, 0, 120),
    }):Play()
end

-- ═══════════════════════════════════════════════════════════════
-- TAB SYSTEM
-- ═══════════════════════════════════════════════════════════════
local Tabs = {}
local ActiveTab = nil
local ListLayout = Scroll:FindFirstChildOfClass("UIListLayout")

local function createTab(name)
    local btn = new("TextButton", {
        Size = UDim2.new(1, -8, 0, 26),
        BackgroundColor3 = Theme.Surface2,
        Text = name, TextColor3 = Theme.TextDim,
        Font = Theme.FontBold, TextSize = 11,
        AutoButtonColor = false, Parent = Sidebar,
    })
    corner(btn, 5)

    local tab = { button = btn, name = name, entries = {} }
    Tabs[#Tabs + 1] = tab

    local function setActive()
        ActiveTab = tab
        for _, t in ipairs(Tabs) do
            local on = t == tab
            t.button.TextColor3     = on and Theme.Text or Theme.TextDim
            t.button.BackgroundColor3 = on and Theme.Accent or Theme.Surface2
        end
        Scroll:ClearAllChildren()
        ListLayout = new("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Scroll,
        })
        for _, fn in ipairs(tab.entries) do fn() end
    end

    tab.setActive = setActive
    function tab:Add(fn)
        table.insert(self.entries, fn)
        if ActiveTab == self then fn() end
    end

    btn.MouseButton1Click:Connect(setActive)

    local idx = 0
    for i, t in ipairs(Tabs) do
        if t == tab then idx = i - 1 break end
    end
    btn.Position = UDim2.new(0, 4, 0, 4 + idx * 30)

    return tab
end

