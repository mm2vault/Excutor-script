-- AUTO GRAB DROPPED GUN
-- ═══════════════════════════════════════════════════════════════
local function findDroppedGun()
    local hrp = getHRP()
    if not hrp then return nil end
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("BasePart") and o.Parent then
            local n = o.Name:lower()
            if n:find("gun") or n:find("revolver") then
                if (o.Position - hrp.Position).Magnitude < 300 then
                    return o
                end
            end
        end
    end
    return nil
end

Connections.AutoGrab = task.spawn(function()
    while task.wait(0.2) do
        if not State.AutoGrabGun then continue end
        local hrp = getHRP()
        if not hrp then continue end
        local gun = findDroppedGun()
        if gun then
            hrp.CFrame = CFrame.new(gun.Position + Vector3.new(0, 2, 0))
            task.wait(0.1)
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- AUTO FARM COINS
-- ═══════════════════════════════════════════════════════════════
local function findNearestCoin()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bdist = nil, math.huge
    local containers = {
        Workspace:FindFirstChild("CoinContainer"),
        Workspace:FindFirstChild("Coins"),
        Workspace,
    }
    for _, c in ipairs(containers) do
        if c then
            for _, o in ipairs(c:GetDescendants()) do
                if o:IsA("BasePart") and o.Parent then
                    local n = o.Name:lower()
                    if n:find("coin") or n:find("money") or n:find("cash") then
                        local d = (o.Position - hrp.Position).Magnitude
                        if d < bdist and d < 500 then bdist, best = d, o end
                    end
                end
            end
        end
    end
    return best
end

Connections.AutoFarm = task.spawn(function()
    while task.wait(0.1) do
        if not State.AutoFarm then continue end
        local hrp = getHRP()
        if not hrp then continue end
        local coin = findNearestCoin()
        if coin then
            hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2, 0))
            task.wait(0.05)
        end
    end
end)

